{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vivado IP 测试矩阵",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds",
        "timing_modes"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "timing_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "continuous",
              "random_gaps",
              "bursts"
            ]
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test_case"
      }
    },
    "includes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sweeps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameter_sweep"
      }
    }
  },
  "$defs": {
    "test_case": {
      "$ref": "#/$defs/case_fields",
      "required": [
        "case_id"
      ]
    },
    "parameter_sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_prefix",
        "template",
        "axes"
      ],
      "properties": {
        "case_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "template": {
          "$ref": "#/$defs/case_fields",
          "not": {
            "required": [
              "case_id"
            ]
          }
        },
        "axes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "oneOf": [
                {"type": ["integer", "string", "boolean"]},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "value"],
                  "properties": {
                    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
                    "value": {
                      "oneOf": [
                        {"type": ["integer", "string", "boolean"]},
                        {"type": "array", "minItems": 1,
                         "items": {"type": ["integer", "string", "boolean"]}}
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "case_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip_type",
        "vendor",
        "ip_name",
        "parameters",
        "stages",
        "verification"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "ip_type": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "ip_name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create_ip",
              "sim_demo",
              "generate_testbench",
              "sim_selfcheck"
            ]
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "strategy_version",
            "random_seed",
            "case_budget",
            "coverage_targets"
          ],
          "properties": {
            "boundary_mode": {
              "enum": [
                "basic",
                "systematic"
              ],
              "default": "basic"
            },
            "input_order": {
              "enum": [
                "generated",
                "shuffled"
              ],
              "default": "generated"
            },
            "timing_mode": {
              "enum": [
                "continuous",
                "random_gaps",
                "bursts"
              ],
              "default": "continuous"
            },
            "max_gap_cycles": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 8
            },
            "burst_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 16
            },
            "strategy": {
              "type": "string",
              "minLength": 1
            },
            "strategy_version": {
              "type": "string",
              "minLength": 1
            },
            "random_seed": {
              "type": "integer",
              "minimum": 0
            },
            "case_budget": {
              "type": "integer",
              "minimum": 1
            },
            "coverage_targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "divider"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/divider/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "multiplier"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/multiplier/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "adder_subtractor"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/adder_subtractor/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "accumulator"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/accumulator/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "counter"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/counter/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "shift_register"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/shift_register/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "distributed_memory"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/distributed_memory/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "vector_logic"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/vector_logic/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ip_type": {
                "const": "reduced_logic"
              }
            },
            "required": [
              "ip_type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "ip/reduced_logic/parameters.schema.json"
              }
            }
          }
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_register_slice"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_register_slice/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_data_fifo"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_data_fifo/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_clock_converter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_clock_converter/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "block_memory"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/block_memory/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "fifo_generator"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/fifo_generator/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "multiply_adder"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/multiply_adder/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "complex_multiplier"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/complex_multiplier/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "tmr_voter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/tmr_voter/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "tmr_comparator"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/tmr_comparator/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_dwidth_converter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_dwidth_converter/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_subset_converter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_subset_converter/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_broadcaster"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_broadcaster/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_combiner"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_combiner/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_switch"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_switch/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_gpio"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_gpio/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_timer"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_timer/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_intc"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_intc/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "xlconcat"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/xlconcat/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "xlslice"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/xlslice/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "xlconstant"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/xlconstant/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "ilconcat"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/ilconcat/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "ilslice"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/ilslice/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "ilconstant"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/ilconstant/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "ilvector_logic"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/ilvector_logic/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "ilreduced_logic"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/ilreduced_logic/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "cordic"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/cordic/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "floating_point"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/floating_point/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "fir_compiler"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/fir_compiler/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "dds_compiler"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/dds_compiler/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "processor_system_reset"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/processor_system_reset/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "clocking_wizard"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/clocking_wizard/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "cic_compiler"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/cic_compiler/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_uartlite"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_uartlite/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "convolution"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/convolution/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "xfft"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/xfft/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_bram_controller"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_bram_controller/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "lmb_bram_controller"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/lmb_bram_controller/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_timebase_wdt"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_timebase_wdt/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "fit_timer"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/fit_timer/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "mutex"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/mutex/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "mailbox"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/mailbox/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "util_ff"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/util_ff/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_apb_bridge"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_apb_bridge/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_fifo_mm_s"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_fifo_mm_s/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "tmr_inject"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/tmr_inject/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_sideband_util"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_sideband_util/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_register_slice"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_register_slice/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_lmb_bridge"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_lmb_bridge/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_clock_converter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_clock_converter/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_protocol_converter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_protocol_converter/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_protocol_checker"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_protocol_checker/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axi_memory_init"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axi_memory_init/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "ahblite_axi_bridge"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/ahblite_axi_bridge/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "axis_protocol_checker"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/axis_protocol_checker/parameters.schema.json"}}}
        },
        {
          "if": {"properties": {"ip_type": {"const": "i2s_transmitter"}}, "required": ["ip_type"]},
          "then": {"properties": {"parameters": {"$ref": "ip/i2s_transmitter/parameters.schema.json"}}}
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "cases"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "includes"
            ]
          },
          {
            "required": [
              "sweeps"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "includes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cases"
            ]
          },
          {
            "required": [
              "sweeps"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "sweeps"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "cases"
            ]
          },
          {
            "required": [
              "includes"
            ]
          }
        ]
      }
    }
  ]
}
