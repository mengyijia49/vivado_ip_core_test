{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reduced_logic 参数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "operation"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "operation": {
      "enum": [
        "and",
        "or",
        "xor"
      ]
    }
  }
}
