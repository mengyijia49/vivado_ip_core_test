{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXI-Stream 位宽转换器参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "input_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "id_width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "dest_width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "user_bits_per_byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "has_keep": {
      "type": "boolean"
    },
    "has_strb": {
      "type": "boolean"
    },
    "has_last": {
      "type": "boolean"
    }
  },
  "required": [
    "input_bytes",
    "output_bytes",
    "id_width",
    "dest_width",
    "user_bits_per_byte",
    "has_keep",
    "has_strb",
    "has_last"
  ]
}
