{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "divider IP 参数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dividend_width",
    "divisor_width",
    "operand_sign"
  ],
  "properties": {
    "dividend_width": {
      "type": "integer",
      "minimum": 1
    },
    "divisor_width": {
      "type": "integer",
      "minimum": 1
    },
    "operand_sign": {
      "enum": [
        "Unsigned",
        "Signed"
      ]
    }
  }
}
