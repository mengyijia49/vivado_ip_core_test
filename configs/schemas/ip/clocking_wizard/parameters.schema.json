{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_frequency_mhz", "output_frequency_mhz", "primitive", "reset_active_high"],
  "properties": {
    "input_frequency_mhz": {"enum": [50, 100, 200]},
    "output_frequency_mhz": {"enum": [25, 50, 100, 125, 200]},
    "primitive": {"enum": ["MMCM", "PLL"]},
    "reset_active_high": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"primitive": {"const": "PLL"}}, "required": ["primitive"]},
      "then": {"properties": {"output_frequency_mhz": {"enum": [50, 100, 200]}}}
    }
  ]
}
