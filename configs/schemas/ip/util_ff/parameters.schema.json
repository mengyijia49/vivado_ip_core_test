{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "util_ff 参数",
  "type": "object",
  "additionalProperties": false,
  "required": ["width", "ff_type", "init_value", "control_active_high", "data_inverted", "gate_active_high"],
  "properties": {
    "width": {"type": "integer", "minimum": 1, "maximum": 1024},
    "ff_type": {"enum": ["FDRE", "FDCE", "FDSE", "FDPE", "LDCE", "LDPE"]},
    "init_value": {"type": "string", "pattern": "^0x[0-9A-Fa-f]+$"},
    "control_active_high": {"type": "boolean"},
    "data_inverted": {"type": "boolean"},
    "gate_active_high": {"type": "boolean"}
  }
}
