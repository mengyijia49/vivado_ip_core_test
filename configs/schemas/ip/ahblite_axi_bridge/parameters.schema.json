{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AHB-Lite to AXI Bridge 参数","type":"object","additionalProperties":false,
  "required":["data_width","address_width","id_width","narrow_burst","non_secure","timeout_cycles","stall_cycles","response_delay_cycles"],
  "properties":{
    "data_width":{"enum":[32,64]},"address_width":{"enum":[32,40,64]},
    "id_width":{"enum":[1,4,8,16]},"narrow_burst":{"type":"boolean"},
    "non_secure":{"type":"boolean"},"timeout_cycles":{"enum":[0,32,64,128,256]},
    "stall_cycles":{"enum":[0,1,3,7]},"response_delay_cycles":{"enum":[0,1,4,8]}
  }
}
