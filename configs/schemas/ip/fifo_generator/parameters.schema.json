{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fifo_generator 参数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "depth",
    "memory_type",
    "active_low_flags",
    "dout_reset_value"
  ],
  "properties": {
    "data_count_width": {"type": "integer", "minimum": 0, "maximum": 18, "default": 0},
    "prog_full_assert": {"type": "integer", "minimum": 0, "maximum": 131071, "default": 0},
    "prog_full_negate": {"type": "integer", "minimum": 0, "maximum": 131070, "default": 0},
    "prog_empty_assert": {"type": "integer", "minimum": 0, "maximum": 131071, "default": 0},
    "prog_empty_negate": {"type": "integer", "minimum": 0, "maximum": 131071, "default": 0},
    "read_mode": {
      "enum": ["standard", "fwft"],
      "default": "standard"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "depth": {
      "enum": [
        16,
        32,
        64,
        128,
        256,
        512,
        1024,
        2048,
        4096,
        8192,
        16384,
        32768,
        65536,
        131072
      ]
    },
    "memory_type": {
      "enum": [
        "Block_RAM",
        "Distributed_RAM"
      ]
    },
    "active_low_flags": {
      "type": "boolean"
    },
    "dout_reset_value": {
      "type": "integer",
      "minimum": 0
    }
  }
}
