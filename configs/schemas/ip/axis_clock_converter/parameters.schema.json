{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "axis_clock_converter 参数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_bytes",
    "id_width",
    "dest_width",
    "user_width",
    "has_last",
    "has_keep",
    "has_strb",
    "synchronization_stages"
  ],
  "properties": {
    "data_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "id_width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "dest_width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "user_width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "has_last": {
      "type": "boolean"
    },
    "has_keep": {
      "type": "boolean"
    },
    "has_strb": {
      "type": "boolean"
    },
    "synchronization_stages": {
      "type": "integer",
      "minimum": 2,
      "maximum": 8
    }
  }
}
