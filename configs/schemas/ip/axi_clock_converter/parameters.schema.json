{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"AXI Clock Converter 参数",
  "type":"object","additionalProperties":false,
  "required":["data_width","address_width","id_width","user_width","synchronization_stages","output_period_ns"],
  "properties":{
    "data_width":{"enum":[32,64,128,256,512,1024]},"address_width":{"enum":[32,40,64]},
    "id_width":{"enum":[1,4,8,16,32]},"user_width":{"enum":[1,8,32,128,1024]},
    "synchronization_stages":{"type":"integer","minimum":2,"maximum":8},
    "output_period_ns":{"enum":[6,10,14,20,30]}
  }
}
