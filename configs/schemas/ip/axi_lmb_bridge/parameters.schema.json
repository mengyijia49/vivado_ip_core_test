{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "axi_lmb_bridge 参数",
  "type": "object",
  "additionalProperties": false,
  "required": ["data_width", "address_width", "id_width", "use_pause", "lmb_protocol", "protection"],
  "properties": {
    "data_width": {"enum": [32, 64]},
    "address_width": {"enum": [32, 40, 64]},
    "id_width": {"enum": [1, 4, 8, 16]},
    "use_pause": {"type": "boolean"},
    "lmb_protocol": {"enum": ["Standard", "Frequency"]},
    "protection": {"type": "boolean"}
  }
}
