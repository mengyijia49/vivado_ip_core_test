{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xlconstant 参数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "width",
    "value"
  ],
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "value": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*|b[01]+|0[0-7]+|0[xX][0-9A-Fa-f]+)$"
    }
  }
}
