{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"AXI Memory Initialization 参数","type":"object","additionalProperties":false,
  "required":["data_width","address_width","id_width","address_size","base_address","init_pattern","stall_cycles","response_delay_cycles","aclken_pause_cycles"],
  "properties":{
    "data_width":{"enum":[32,64,128,256,512,1024]},
    "address_width":{"enum":[24,32,64]},
    "id_width":{"enum":[1,4,8,16,32]},
    "address_size":{"enum":[11,12,13,14]},
    "base_address":{"enum":[0,1048576]},
    "init_pattern":{"enum":["Zero","Ones","Alternating","EdgeBits"]},
    "stall_cycles":{"enum":[0,1,3,7]},
    "response_delay_cycles":{"enum":[0,1,4,8]},
    "aclken_pause_cycles":{"enum":[0,1,4,8]}
  }
}
