{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "accumulator 参数",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_width",
    "output_width",
    "input_type",
    "operation",
    "clock_enable",
    "sync_clear",
    "ce_overrides_reset",
    "bypass"
  ],
  "properties": {
    "input_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "output_width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "input_type": {
      "enum": [
        "Unsigned",
        "Signed"
      ]
    },
    "operation": {
      "enum": [
        "Add",
        "Subtract",
        "Add_Subtract"
      ]
    },
    "clock_enable": {
      "type": "boolean"
    },
    "sync_clear": {
      "type": "boolean"
    },
    "ce_overrides_reset": {
      "type": "boolean"
    },
    "bypass": {
      "type": "boolean"
    }
  }
}
