{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CORDIC 平方根参数",
  "type": "object", "additionalProperties": false,
  "required": ["function","input_width","output_width","data_format","rounding","architecture","pipelining","optimization","has_last","user_width"],
  "properties": {
    "function": {"const":"Square_Root"},
    "input_width": {"type":"integer","minimum":8,"maximum":48},
    "output_width": {"type":"integer","minimum":5,"maximum":48},
    "data_format": {"enum":["UnsignedInteger","UnsignedFraction"]},
    "rounding": {"enum":["Truncate","Round_Pos_Inf","Round_Pos_Neg_Inf","Nearest_Even"]},
    "architecture": {"const":"Parallel"},
    "pipelining": {"enum":["No_Pipelining","Optimal","Maximum"]},
    "optimization": {"enum":["Resources","Performance"]},
    "has_last": {"type":"boolean"},
    "user_width": {"type":"integer","minimum":0,"maximum":256}
  }
}
