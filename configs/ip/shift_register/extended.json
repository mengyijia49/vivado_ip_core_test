{
  "$schema": "../../schemas/ip_matrix.schema.json",
  "schema_version": 2,
  "sweeps": [
    {
      "case_prefix": "shift_wide",
      "template": {
        "ip_type": "shift_register",
        "vendor": "xilinx.com",
        "ip_name": "c_shift_ram",
        "parameters": {
          "width": 8,
          "depth": 17,
          "clock_enable": true
        },
        "stages": [
          "create_ip",
          "generate_testbench",
          "sim_selfcheck"
        ],
        "verification": {
          "strategy": "directed_random",
          "strategy_version": "1.0",
          "random_seed": 2026,
          "case_budget": 8192,
          "coverage_targets": [
            "port_boundaries"
          ],
          "boundary_mode": "systematic",
          "input_order": "generated",
          "timing_mode": "continuous",
          "max_gap_cycles": 8,
          "burst_length": 16
        }
      },
      "axes": {
        "width": [
          16,
          17,
          31,
          32,
          33,
          64,
          128,
          256
        ],
        "depth": [
          1,
          2,
          3,
          15,
          16,
          17,
          31,
          32,
          33,
          63,
          64,
          65,
          127,
          128,
          129,
          256,
          512,
          1024
        ],
        "clock_enable": [
          false,
          true
        ]
      }
    },
    {
      "case_prefix": "shift_byte",
      "template": {
        "ip_type": "shift_register",
        "vendor": "xilinx.com",
        "ip_name": "c_shift_ram",
        "parameters": {
          "width": 8,
          "depth": 16,
          "clock_enable": true
        },
        "stages": [
          "create_ip",
          "generate_testbench",
          "sim_selfcheck"
        ],
        "verification": {
          "strategy": "exhaustive",
          "strategy_version": "1.0",
          "random_seed": 2026,
          "case_budget": 512,
          "coverage_targets": [
            "port_boundaries",
            "complete_input_space"
          ],
          "boundary_mode": "systematic",
          "input_order": "generated",
          "timing_mode": "continuous",
          "max_gap_cycles": 8,
          "burst_length": 16
        }
      },
      "axes": {
        "width": [
          1,
          2,
          7,
          8
        ],
        "depth": [
          1,
          2,
          16,
          17,
          32,
          33,
          128,
          1024
        ],
        "clock_enable": [
          false,
          true
        ]
      }
    }
  ]
}
