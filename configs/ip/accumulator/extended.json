    {
      "case_prefix": "acc_wide",
      "template": {
        "ip_type": "accumulator",
        "vendor": "xilinx.com",
        "ip_name": "c_accum",
        "parameters": {
          "input_width": 8,
          "output_width": 256,
          "input_type": "Signed",
          "operation": "Add_Subtract",
          "clock_enable": true,
          "sync_clear": true,
          "ce_overrides_reset": false,
          "bypass": true
        },
        "stages": [
          "create_ip",
          "generate_testbench",
          "sim_selfcheck"
        ],
        "verification": {
          "strategy": "directed_random",
          "strategy_version": "1.0",
          "random_seed": 2026,
          "case_budget": 8192,
          "coverage_targets": [
            "port_boundaries"
          ],
          "boundary_mode": "systematic",
          "input_order": "generated",
          "timing_mode": "continuous",
          "max_gap_cycles": 8,
          "burst_length": 16
        }
      },
