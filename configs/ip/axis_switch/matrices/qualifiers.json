{
  "$schema": "../../../schemas/ip_matrix.schema.json",
  "schema_version": 2,
  "sweeps": [
    {
      "case_prefix": "switch_qualifiers",
      "template": {
        "ip_type": "axis_switch",
        "vendor": "xilinx.com",
        "ip_name": "axis_switch",
        "parameters": {
          "inputs": 3,
          "outputs": 5,
          "data_bytes": 7,
          "user_width": 9,
          "id_width": 3,
          "dest_width": 4,
          "has_keep": true,
          "has_strb": true,
          "has_last": true,
          "decoder_reg": true,
          "output_reg": true,
          "arbiter": "true_round_robin",
          "arbitrate_transfers": 1,
          "arbitrate_cycles": 0,
          "arbitrate_last": false,
          "routing": "balanced"
        },
        "stages": [
          "create_ip",
          "generate_testbench",
          "sim_selfcheck"
        ],
        "verification": {
          "strategy": "directed_random",
          "strategy_version": "1.0",
          "random_seed": 2026,
          "case_budget": 1024,
          "coverage_targets": [
            "port_boundaries"
          ],
          "boundary_mode": "basic",
          "input_order": "shuffled",
          "timing_mode": "random_gaps",
          "max_gap_cycles": 8,
          "burst_length": 16
        }
      },
      "axes": {
        "data_bytes": [
          1,
          2,
          3,
          15,
          16,
          31,
          32,
          127,
          128,
          511,
          512
        ],
        "user_width": [
          0,
          1,
          33,
          4096
        ],
        "id_width": [
          0,
          1,
          32
        ],
        "has_keep": [
          false,
          true
        ],
        "has_strb": [
          false,
          true
        ],
        "has_last": [
          false,
          true
        ],
        "decoder_reg": [
          false,
          true
        ],
        "output_reg": [
          false,
          true
        ]
      }
    }
  ]
}
