{
  "$schema": "../../schemas/ip_matrix.schema.json",
  "schema_version": 2,
  "sweeps": [
    {
      "case_prefix": "convolution_unpunctured",
      "template": {
        "ip_type": "convolution",
        "vendor": "xilinx.com",
        "ip_name": "convolution",
        "parameters": {"constraint_length": 7, "output_rate": 2, "code_family": "ascending"},
        "stages": ["create_ip", "generate_testbench", "sim_selfcheck"],
        "verification": {"strategy": "directed_random", "strategy_version": "1.0", "random_seed": 2026, "case_budget": 128, "coverage_targets": ["port_boundaries"], "boundary_mode": "systematic", "input_order": "generated", "timing_mode": "random_gaps", "max_gap_cycles": 8, "burst_length": 16}
      },
      "axes": {
        "constraint_length": [3, 4, 5, 6, 7, 8, 9],
        "output_rate": [2, 3, 4, 5, 6, 7],
        "code_family": ["ascending", "descending", "spread"]
      }
    }
  ]
}
