{
  "$schema": "../../schemas/ip_matrix.schema.json",
  "schema_version": 2,
  "sweeps": [
    {
      "case_prefix": "mutex_matrix",
      "template": {
        "ip_type": "mutex", "vendor": "xilinx.com", "ip_name": "mutex",
        "parameters": {"num_interfaces": 2, "num_mutexes": 1, "enable_user": false, "hardware_protection": false},
        "stages": ["create_ip", "generate_testbench", "sim_selfcheck"],
        "verification": {"strategy": "exhaustive", "strategy_version": "1.0", "random_seed": 20261007, "case_budget": 1, "coverage_targets": ["ownership", "cross_port_visibility", "arbitration", "reset"], "boundary_mode": "systematic", "input_order": "generated", "timing_mode": "continuous", "max_gap_cycles": 8, "burst_length": 16}
      },
      "axes": {
        "num_interfaces": [2, 4, 8],
        "num_mutexes": [1, 2, 16, 32],
        "enable_user": [false, true],
        "hardware_protection": [false, true]
      }
    }
  ]
}
