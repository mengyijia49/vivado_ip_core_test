{
  "$schema": "../../schemas/ip_matrix.schema.json",
  "schema_version": 2,
  "sweeps": [
    {
      "case_prefix": "uartlite_loopback",
      "template": {
        "ip_type": "axi_uartlite",
        "vendor": "xilinx.com",
        "ip_name": "axi_uartlite",
        "parameters": {"baud_rate": 115200, "data_bits": 8, "parity": "None"},
        "stages": ["create_ip", "generate_testbench", "sim_selfcheck"],
        "verification": {"strategy": "directed_random", "strategy_version": "1.0", "random_seed": 2026, "case_budget": 256, "coverage_targets": ["port_boundaries"], "boundary_mode": "systematic", "input_order": "generated", "timing_mode": "random_gaps", "max_gap_cycles": 8, "burst_length": 16}
      },
      "axes": {
        "baud_rate": [9600, 19200, 38400, 57600, 115200, 128000, 230400],
        "data_bits": [5, 6, 7, 8],
        "parity": ["None", "Even", "Odd"]
      }
    }
  ]
}
