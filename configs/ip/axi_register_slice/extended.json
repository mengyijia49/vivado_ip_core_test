{
  "$schema": "../../schemas/ip_matrix.schema.json",
  "schema_version": 2,
  "sweeps": [
    {
      "case_prefix": "axi_register_slice",
      "template": {
        "ip_type": "axi_register_slice", "vendor": "xilinx.com", "ip_name": "axi_register_slice",
        "parameters": {"data_width": 32, "id_width": 1, "address_user_width": 1, "data_user_width": 1, "response_user_width": 1, "forward_mode": "Bypass", "response_mode": "Bypass"},
        "stages": ["create_ip", "generate_testbench", "sim_selfcheck"],
